# Clerk server-side verification. Copy the PEM JWT public key from Clerk Dashboard -> API keys -> Show JWT public key.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-your-clerk-jwt-public-key\n-----END PUBLIC KEY-----"
CLERK_ALLOWED_EMAIL=hellocloud.webdev@gmail.com

# Vite build-time public key (put this in .env, not .dev.vars).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Neon PostgreSQL connection string (pooled or direct serverless connection)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Zoho SMTP (use the server shown for your Zoho data centre; India DC uses smtp.zoho.in)
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USERNAME=mail@neerajsingh.me
ZOHO_SMTP_FROM_NAME=Neeraj Singh
ZOHO_SMTP_PASSWORD=your-zoho-app-password

# Generate a random 32-byte key and base64-encode it; set the same value with Wrangler secret.
LLM_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
