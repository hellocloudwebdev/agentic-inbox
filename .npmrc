# agents@0.33.0 declares an OPTIONAL peer dependency on @ai-sdk/provider@^4
# (the AI SDK v7 generation). This repo is on the AI SDK v6 stack (ai@^6 →
# @ai-sdk/provider@^3, required by @ai-sdk/anthropic and workers-ai-provider),
# and the agents modules the app imports (McpAgent, routeAgentRequest,
# useAgentChat) do not use that optional peer. legacy-peer-deps lets npm
# accept the mismatch instead of failing ERESOLVE; the committed
# package-lock.json pins the exact resolved tree.
legacy-peer-deps=true
